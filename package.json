{
  "name": "nextjs-payloadcms-typescript-template",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "standard-version": {
    "scripts": {
      "prebump": "nfqBump"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "template": {
    "version": "1.1.0",
    "name": "nextjs-payloadcms-typescript-template",
    "path": "https://github.com/nfqde/nextjs-payloadcms-typescript-template.git"
  },
  "scripts": {
    "analyze": "cross-env ANALYZE=true FEATURE_ENV=live next build --webpack",
    "analyze:browser": "cross-env ANALYZE=true BUNDLE_ANALYZE=browser FEATURE_ENV=live next build --webpack",
    "analyze:server": "cross-env ANALYZE=true BUNDLE_ANALYZE=server FEATURE_ENV=live next build --webpack",
    "build:live": "cross-env NODE_ENV=production FEATURE_ENV=live next build --webpack",
    "build:stage": "cross-env NODE_ENV=production FEATURE_ENV=stage next build --webpack",
    "build:test": "cross-env NODE_ENV=production FEATURE_ENV=test next build --webpack",
    "check:types": "tsc -p .",
    "deploy": "standard-version && git push --follow-tags origin main",
    "dev": "python -t -m webbrowser https://payload.nfq.local && cross-env FEATURE_ENV=dev yarn next dev --webpack -H payload.nfq.local -p 3000",
    "lint": "eslint ./src --ext='.js' --ext='.jsx' --ext='.ts' --ext='.tsx'",
    "lint:report": "eslint --output-file eslint_report.json --format json --ext='.js, .jsx, .ts, .tsx' ./src",
    "merge:files": "mochawesome-merge \"./cypress/reports/mochawesome*.json\" > \"./cypress/reports/index.json\"",
    "start": "cross-env NODE_ENV=production next start -p 3000",
    "start:test": "start-server-and-test 'yarn run start' http://localhost:3000 'yarn run test'",
    "start:test:merge": "start-server-and-test 'yarn run start' http://localhost:3000 'yarn run test:merge'",
    "test:open": "cross-env NODE_ENV=test yarn cypress open",
    "test:cypress:ct": "cross-env NODE_ENV=test yarn cypress run --component && yarn merge:files",
    "test:cypress:integration": "cross-env NODE_ENV=test yarn cypress run",
    "test:merge": "yarn run test:cypress:integration && yarn run test:cypress:ct && yarn nfqReport",
    "test": "yarn run test:cypress:integration && yarn run test:cypress:ct",
    "generate:importMap": "cross-env PAYLOAD_CONFIG_PATH=src/server/payload/payload.config.ts payload generate:importMap",
    "generate:payloadTypes": "cross-env PAYLOAD_CONFIG_PATH=src/server/payload/payload.config.ts payload generate:types",
    "generate:featureTypes": "nfq-generate-types -f \"@app/features\" -j \"@nfq/feature-flags/jsx\" -i \"WithFeature\" -x \"WithoutFeature\" -e stage",
    "generate:types": "yarn generate:payloadTypes && yarn generate:featureTypes",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "cross-env NODE_ENV=development FEATURE_ENV=stage storybook build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@nfq/autobind": "^1.1.4",
    "@nfq/colors": "^3.1.4",
    "@nfq/next-fonts": "^1.7.2",
    "@nfq/react-form": "^1.2.1",
    "@nfq/react-grid": "^7.0.1",
    "@nfq/typed-next-api": "1.8.0",
    "@payloadcms/db-mongodb": "3.84.1",
    "@payloadcms/live-preview-react": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/plugin-form-builder": "^3.84.1",
    "@payloadcms/plugin-nested-docs": "3.84.1",
    "@payloadcms/plugin-seo": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/richtext-slate": "3.84.1",
    "@payloadcms/translations": "3.84.1",
    "@payloadcms/ui": "3.84.1",
    "@storybook/nextjs-vite": "^10.4.1",
    "graphql": "^16.14.0",
    "mobx": "^6.15.3",
    "mobx-react-lite": "^4.1.1",
    "motion": "^12.40.0",
    "msw-storybook-addon": "^2.0.7",
    "next": "16.2.6",
    "next-connect": "^1.0.0",
    "patch-package": "^8.0.1",
    "payload": "^3.84.1",
    "postinstall-postinstall": "^2.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.3",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@cypress/code-coverage": "^4.0.3",
    "@next/bundle-analyzer": "16.2.6",
    "@next/env": "16.2.6",
    "@nfq/eslint-config": "4.0.0-beta.23",
    "@nfq/feature-flags": "^16.1.2",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/cypress__code-coverage": "^3.10.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "cypress": "^15.15.0",
    "cypress-real-events": "^1.15.0",
    "duplicate-package-checker-webpack-plugin": "^3.0.0",
    "eslint": "^9.39.4",
    "html-webpack-plugin": "^5.6.7",
    "mocha": "^11.7.6",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "nyc": "^18.0.0",
    "react-is": "^19.2.6",
    "semver": "^7.8.1",
    "start-server-and-test": "^3.0.5",
    "storybook": "^10.4.1",
    "swc-plugin-coverage-instrument": "^0.0.32",
    "typescript": "^6.0.3",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  }
}
